  "narrative": {
    "northStar": "The Rack Label",
    "overview": "Customer store only. The store looks like the rack an order is picked from: label strips, a yellow dock plate, a pick list that stays in view and a reservation hang tag. Concrete ground, graphite structure, signal yellow as the one voice.",
    "keyCharacteristics": [
      "Label stock on concrete; yellow only for the next action, the picked state and the pickup plate.",
      "Condensed stencilled caps for names, prices and actions; system sans for sentences.",
      "The availability word is always printed; only the plate around it changes.",
      "Quantity is drawn as length: a bar of whole cells grows under the stepper."
    ],
    "rules": [
      { "name": "The One Voice Rule", "body": "Yellow marks only what the customer should touch or what is already theirs.", "section": "colors" },
      { "name": "The Hazard Hatch Rule", "body": "Hatching exists only on the Pocas tag.", "section": "colors" },
      { "name": "The Word Always Printed Rule", "body": "Availability and order status are words first, plates second.", "section": "typography" },
      { "name": "The Flat-Plate Rule", "body": "Frame surfaces with graphite, never shade them.", "section": "elevation" }
    ],
    "dos": [
      "Do print the availability word and the order status every time.",
      "Do keep prices in tabular condensed numerals, right-aligned in one column.",
      "Do frame with 2px graphite and 1px rules; keep radii at 2px.",
      "Do keep the pickup warehouse and the \"reserve, not pay\" sentence visible on every ordering step."
    ],
    "donts": [
      "Don't use hatching anywhere except the Pocas tag.",
      "Don't add shadows, gradients, glass or photo-card grids to the store.",
      "Don't present catalog index letters as physical rack locations.",
      "Don't carry this look into the staff console."
    ]
